  "targets": [
    {
      "name": "StatusBuddy",
      "id": "DD88E54F23F34ECE009C4060",
      "product": "Products/StatusBuddy.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Config", "relative-path": "AppTarget-AppStore.xcconfig" } },
        { "name": "Debug-DeveloperID", "file": { "anchor": "Config", "relative-path": "AppTarget-DeveloperID.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Config", "relative-path": "AppTarget-AppStore.xcconfig" } },
        { "name": "Release-DeveloperID", "file": { "anchor": "Config", "relative-path": "AppTarget-DeveloperID.xcconfig" } },
      ],
      "dependencies": [
        { "kind": "package", "package": "Sparkle", "product-name": "Sparkle" },
        "StatusBuddyHelper",
        "StatusCore",
        "StatusUI",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Generate TestFlight WhatToTest Notes",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/TestFlight/WhatToTest.txt",
          ],
          "output-paths": [
            "$(SRCROOT)/TestFlight/WhatToTest.en-US.txt",
            "$(SRCROOT)/TestFlight/WhatToTest.en-GB.txt",
          ],
          "run-on-every-build": true,
          "scope": "install",
          "shell": "/bin/bash",
          "script": [
            "echo \"Copying generic TestFlight notes into en-US and en-GB locale files\"",
            "",
            "cat \"$SCRIPT_INPUT_FILE_0\" > \"$SCRIPT_OUTPUT_FILE_0\"",
            "cat \"$SCRIPT_INPUT_FILE_0\" > \"$SCRIPT_OUTPUT_FILE_1\"",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "script",
          "name": "Embed Sparkle in Developer ID Build",
          "log-environment-variables": true,
          "input-paths": [
            "$(BUILT_PRODUCTS_DIR)/Sparkle.framework",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/Sparkle.framework",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -euo pipefail",
            "",
            "if [[ \"${IS_APPSTORE_BUILD:-0}\" == \"1\" ]]; then",
            "    exit 0",
            "fi",
            "",
            "source_framework=\"${BUILT_PRODUCTS_DIR}/Sparkle.framework\"",
            "frameworks_directory=\"${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}\"",
            "destination_framework=\"${frameworks_directory}/Sparkle.framework\"",
            "",
            "if [[ ! -d \"${source_framework}\" ]]; then",
            "    echo \"error: Missing ${source_framework}\"",
            "    exit 1",
            "fi",
            "",
            "/bin/mkdir -p \"${frameworks_directory}\"",
            "/bin/rm -rf \"${destination_framework}\"",
            "/usr/bin/ditto \"${source_framework}\" \"${destination_framework}\"",
            "",
            "# Match Xcode's RemoveHeadersOnCopy behavior for embedded frameworks.",
            "/usr/bin/find \"${destination_framework}\" \\",
            "    \\( -type d -o -type l \\) \\",
            "    \\( -name Headers -o -name PrivateHeaders -o -name Modules \\) \\",
            "    -prune -exec /bin/rm -rf {} +",
            "",
            "if [[ \"${CODE_SIGNING_ALLOWED:-NO}\" == \"YES\" &&",
            "      -n \"${EXPANDED_CODE_SIGN_IDENTITY:-}\" ]]; then",
            "    sign_arguments=(",
            "        --force",
            "        --sign \"${EXPANDED_CODE_SIGN_IDENTITY}\"",
            "        --options runtime",
            "        --preserve-metadata=identifier,entitlements,flags",
            "        --generate-entitlement-der",
            "    )",
            "",
            "    if [[ \"${EXPANDED_CODE_SIGN_IDENTITY_NAME:-}\" == *\"Developer ID Application\"* ]]; then",
            "        sign_arguments+=(--timestamp)",
            "    else",
            "        sign_arguments+=(--timestamp=none)",
            "    fi",
            "",
            "    /usr/bin/codesign \"${sign_arguments[@]}\" \"${destination_framework}\"",
            "fi",
            "",
          ],
        }, {
          "kind": "copy",
          "name": "Embed Login Item",
          "bundle-base-path": "root",
          "relative-path": "Contents/Library/LoginItems",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "StatusBuddy/StatusBuddy.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release]": "StatusBuddy/StatusBuddy.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_ASSET_PATHS": "\"StatusBuddy/Preview Content\"",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "StatusBuddy/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "tech.buddysoftware.StatusBuddy",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
      },
