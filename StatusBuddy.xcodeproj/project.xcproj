          "target": "StatusBuddyHelper",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/StatusBuddy.app", "id": "DD88E55023F34ECE009C4060", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/StatusCore.framework",
          "id": "DD88E56B23F34EE1009C4060",
          "type": "wrapper.framework",
          "index": false,
          "target-membership": [
            { "build-phase": "StatusBuddy/frameworks", "is-weak": true },
            { "build-phase": "StatusBuddy/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "StatusUI/frameworks",
            "StatusCoreTests/frameworks",
            "StatusUITests/frameworks",
          ],
        }, {
          "path": "<PRODUCTS>/StatusUI.framework",
          "id": "F4AFF30C268B6807002C26FC",
          "type": "wrapper.framework",
          "index": false,
          "target-membership": [
            "StatusBuddy/frameworks",
            { "build-phase": "StatusBuddy/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "StatusUITests/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/StatusCoreTests.xctest", "id": "F414B5A3268CA70C00C98255", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/StatusUITests.xctest", "id": "F4A58BC6268CC7E100C11441", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/StatusBuddyHelper.app", "id": "F4918BC527720ADB009CC98D", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "StatusBuddy/copy/Embed Login Item", "header-preservation": "remove-on-copy" } ] },
      ],
